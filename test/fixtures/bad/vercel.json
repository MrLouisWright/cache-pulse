{
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }, { "key": "Vary", "value": "*" }] },
    { "source": "/styles.css", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }, { "key": "Set-Cookie", "value": "a=b" }] },
    { "source": "/img/(.*)", "headers": [{ "key": "Content-Encoding", "value": "gzip" }, { "key": "Cache-Control", "value": "no-store" }] }
  ]
}
